{
  "name": "helix-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4747 --turbopack",
    "dev:webpack": "next dev --hostname 127.0.0.1 --port 4747",
    "dev:lan": "NON_OS_LAN=1 NON_OS_ALLOW_LAN=1 NON_OS_BIND=0.0.0.0 next dev --hostname 0.0.0.0 --port 4747 --turbopack",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4747",
    "start:lan": "NON_OS_LAN=1 NON_OS_ALLOW_LAN=1 NON_OS_BIND=0.0.0.0 next start --hostname 0.0.0.0 --port 4747",
    "lint": "eslint",
    "reindex": "tsx scripts/reindex.ts",
    "watch": "tsx scripts/watch-reindex.ts",
    "sync:pdfjs": "cp -f node_modules/pdfjs-dist/build/pdf.min.mjs public/pdf.min.mjs && cp -f node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.44",
    "@ai-sdk/xai": "^4.0.21",
    "3d-force-graph": "^1.80.0",
    "ai": "^7.0.41",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "force-graph": "^1.51.4",
    "lucide-react": "^1.27.0",
    "mime": "^4.1.0",
    "next": "15.5.22",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "picomatch": "^4.0.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime": "^3.0.4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
